{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decode Disk Doctor",
  "version": "0.1.0",
  "identifier": "com.decodeanalytics.diskdoctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Decode Disk Doctor",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": ["app", "deb", "rpm", "nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Disk diagnostics and recovery toolkit",
    "longDescription": "Local-first disk diagnostics and recovery platform by Decode Analytics."
  }
}
